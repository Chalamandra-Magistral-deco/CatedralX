#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PYTHON="${CATEDRALX_PYTHON:-python3}"
export PYTHONPATH="$ROOT/elite${PYTHONPATH:+:$PYTHONPATH}"
case "${1:-status}" in
  status|b-status|nexus)
    exec "$PYTHON" "$ROOT/elite/bin/nexus.py"
    ;;
  feed-once)
    exec "$PYTHON" "$ROOT/elite/bin/feed_once.py"
    ;;
  motor)
    export PYTHONPATH="$ROOT/elite${PYTHONPATH:+:$PYTHONPATH}"
    exec "$PYTHON" -m REASON.razon
    ;;
  ciclo)
    "$PYTHON" "$ROOT/elite/bin/feed_once.py"
    exec "$ROOT/BIN/catedral" motor
    ;;
  impact-cycle)
    exec "$PYTHON" "$ROOT/elite/bin/impact_cycle.py" "${@:2}"
    ;;
  user-feedback)
    shift
    exec "$PYTHON" "$ROOT/elite/bin/user_feedback.py" "$@"
    ;;
  dispatch-agents)
    shift
    exec "$PYTHON" "$ROOT/elite/bin/dispatch_agents.py" "$@"
    ;;
  test|probar)
    exec "$PYTHON" -m pytest -q -p no:cacheprovider "$ROOT/tests"
    ;;
  help|-h|--help)
    printf "%s\n" "Uso: catedral {status|feed-once|motor|ciclo|impact-cycle|user-feedback|dispatch-agents|test|help}" "status muestra estado local de solo lectura" "feed-once descarga velas publicas cerradas y escribe snapshot RSX" "motor ejecuta un ciclo SCX con un snapshot RSX real y valido" "ciclo actualiza RSX y ejecuta un unico analisis SCX" "impact-cycle pasa --report o --event y argumentos al ciclo gobernado de impacto" "user-feedback registra feedback de usuario o muestra su resumen; no modifica reglas" "dispatch-agents --cycle-id <id> despacha una propuesta autorizada a Agents" "dispatch-agents envía una tarea autenticada a Agents; solo se ejecuta bajo invocación explícita" "test ejecuta pruebas automatizadas" "No habilita órdenes ni inicia daemons."
    ;;
  *)
    echo "Comando desconocido: $1" >&2
    exit 2
    ;;
esac
