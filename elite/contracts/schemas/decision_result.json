{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "result_id",
    "status",
    "engine",
    "decision",
    "evidence",
    "assumptions",
    "risks",
    "provenance",
    "trace_id",
    "analysis_only",
    "orders_created",
    "orders_executed",
    "evaluation_hash",
    "evaluation_gate",
    "cycle_id"
  ],
  "properties": {
    "result_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "ACCEPTED",
        "UNCERTAIN",
        "REJECTED",
        "BLOCKED_MISSING_INPUT"
      ]
    },
    "engine": {
      "type": "string",
      "const": "CatedralX"
    },
    "decision": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "analysis_only": {
      "type": "boolean",
      "const": true
    },
    "orders_created": {
      "type": "boolean",
      "const": false
    },
    "orders_executed": {
      "type": "boolean",
      "const": false
    },
    "next_action": {
      "type": "string"
    },
    "evaluation_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "missing_inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocking_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evaluation_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "evaluation_gate": {
      "type": "string",
      "enum": [
        "ACCEPTED",
        "REJECTED",
        "BLOCKED_EVIDENCE",
        "BLOCKED_REINVERSION",
        "BLOCKED_UNCERTAINTY",
        "BLOCKED_DEFICIT"
      ]
    },
    "cycle_id": {
      "type": [
        "string",
        "integer",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ACCEPTED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "evidence": {
            "minItems": 1
          },
          "provenance": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
